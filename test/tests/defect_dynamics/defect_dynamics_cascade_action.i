# [DefectDynamics] action equivalent of defect_dynamics_opposite_absorption_small_action.i, but
# both species now set a nonzero cascade_f2/f3/f4, so each seeds cluster sizes 2, 3, and 4
# directly from the cascade (Pokor et al. 2004, Eqs 1a-1e) instead of putting the entire
# generation rate into the monomer row -- a nonzero fraction is itself the activation signal, no
# separate switch is needed. The two species deliberately use different fractions (vacancy favors
# f2, interstitial favors f4) to confirm each species' own per-species values are used, not a
# shared pair.

[Mesh]
  type = SingleNodeMesh
  position = '0 0 0'
[]

[Problem]
  use_hash_table_matrix_assembly = true
  restore_original_nonzero_pattern = false
[]

[DefectDynamics]
  temperature = 573
  atomic_volume = 1.1664e-29
  lattice_parameter = 0.36e-9
  dpa_rate = 1.5e-3
  cascade_efficiency = 0.1
  dislocation_density = 1e15

  [vacancy]
    geometry = void
    D0 = 1.19073105525e-8
    Em = 0.7644
    Ef = 1.7
    Eb2 = 0.5
    exponent = 0.67
    Z = 1.0
    num_cluster_sizes = 30
    cascade_f2 = 0.2
    cascade_f3 = 0.05
    cascade_f4 = 0.02
    explicit_max = 6
    group_spacing = linear
    group_linear_width = 4
    group_geometric_ratio = 1.5
  []

  [interstitial]
    geometry = loop
    D0 = 8.781e-8
    Em = 0.4684
    Ef = 4.1
    Eb2 = 0.6
    exponent = 0.8
    Z = 1.1
    Z_loop = 63.0
    alpha = 0.8
    Z_loop_opposite = 33.0
    alpha_opposite = 0.65
    num_cluster_sizes = 30
    cascade_f2 = 0.05
    cascade_f3 = 0.05
    cascade_f4 = 0.1
    explicit_max = 6
    group_spacing = linear
    group_linear_width = 4
    group_geometric_ratio = 1.5
  []
[]

[Preconditioning]
  [smp]
    type = SMP
    full = true
  []
[]

[Executioner]
  type = Transient
  solve_type = NEWTON
  petsc_options_iname = '-pc_type -pc_factor_mat_ordering_type'
  petsc_options_value = 'lu       nd'
  nl_rel_tol = 1e-8
  nl_abs_tol = 1e-20
  dt = 1e-5
  num_steps = 3
[]

[Outputs]
  csv = true
[]
