    allow_warnings = false
  []
  [cluster_dynamics_grouped_geometric]
    type = CSVDiff
    input = cluster_dynamics_grouped_small.i
    cli_args = 'GlobalParams/group_spacing=geometric GlobalParams/group_geometric_ratio=1.5 Outputs/file_base=cluster_dynamics_grouped_geometric_out'
    csvdiff = 'cluster_dynamics_grouped_geometric_out.csv'
    design = 'GenericClusterDynamicsGroupedNodalKernel.md'
    requirement = 'BlackBear shall evolve explicit small clusters and a geometrically graded L0/L1 grouped tail in one nodal array variable.'
  []
  [cluster_dynamics_grouping_disabled]
    type = CSVDiff
    input = cluster_dynamics_grouped_small.i
    # Diffs against gold/cluster_dynamics_50_combined_out.csv -- the SAME gold file
    # cluster_dynamics_50_combined_ad/_nonad use for the fully explicit, ungrouped
    # ClusterDynamicsNodalKernel -- not a separately generated file that happens to agree. This
    # makes Golubov et al. (2001)'s grouping-validity criterion (a) (the grouped equations must be
    # identical to the ungrouped ones in the limiting case of unit-width bins) an enforced
    # regression rather than a coincidence a manual diff could happen to catch: if a future change
    # to either kernel's residual breaks this equivalence, this test fails immediately.
    cli_args = 'GlobalParams/use_grouping=false Outputs/file_base=cluster_dynamics_50_combined_out'
    csvdiff = 'cluster_dynamics_50_combined_out.csv'
    design = 'GenericClusterDynamicsGroupedNodalKernel.md'
    requirement = 'BlackBear shall produce results from the grouped cluster-dynamics interface with grouping disabled that are identical to the fully explicit, ungrouped ClusterDynamicsNodalKernel, satisfying the grouping method\'s validity criterion that grouped and ungrouped equations agree exactly in the limiting case of unit-width bins.'
  []
