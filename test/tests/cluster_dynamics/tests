    difference_tol = 1e-6
    design = 'GenericClusterDynamicsGroupedNodalKernel.md'
    requirement = 'BlackBear shall provide an analytical intra-variable Jacobian for the ClusterDynamicsGroupedNodalKernel with a fixed-width, slope-limited L0/L1 grouped tail.'
  []
