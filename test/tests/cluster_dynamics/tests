    design = 'GenericClusterDynamicsGroupedNodalKernel.md'
    requirement = 'BlackBear shall provide an analytical intra-variable Jacobian for the ClusterDynamicsGroupedNodalKernel with a geometrically graded, unlimited L0/L1 grouped tail.'
  []
