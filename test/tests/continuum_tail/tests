[Tests]
  [continuum_loop_jacobian]
    type = PetscJacobianTester
    input = continuum_loop_jacobian.i
    run_sim = True
    ratio_tol = 1e-7
    design = 'ContinuumLoopNodalKernel.md'
    requirement = 'BlackBear shall provide a Jacobian for the discrete-plus-continuum loop kernel, including the dependence of the minmod-limited face values on the neighboring cells, that agrees with a finite difference of its residual.'
  []
  [continuum_pair_jacobian]
    type = PetscJacobianTester
    input = continuum_pair_jacobian.i
    run_sim = True
    ratio_tol = 1e-7
    # The entries are of order 1e10 (the monomer rows hold the loop absorption rates), so a relative
    # difference of 1e-9 is an absolute Frobenius difference of order 1e5, far above the default of 1
    difference_tol = 1e6
    design = 'ContinuumLoopNodalKernel.md'
    requirement = 'BlackBear shall provide a Jacobian, including the off-diagonal blocks, for two coupled discrete-plus-continuum loop families that shrink by absorbing each other\'s monomers, that agrees with a finite difference of the residual.'
  []
  [continuum_pair_own_block_jacobian]
    # The same input with the cross-variable block written from the own-variable call of each kernel and no off_diag pair
    # in the preconditioner (SMP full = false); without the setting this input gives a ratio of about 0.85
    type = PetscJacobianTester
    input = continuum_pair_jacobian.i
    cli_args = "Preconditioning/smp/full=false NodalKernels/vacancy_dyn/assemble_opposite_jacobian_in_own_block=true NodalKernels/interstitial_dyn/assemble_opposite_jacobian_in_own_block=true"
    run_sim = True
    ratio_tol = 1e-7
    difference_tol = 1e6
    allow_warnings = false
    design = 'ContinuumLoopNodalKernel.md'
    requirement = 'BlackBear shall provide the same Jacobian for two coupled discrete-plus-continuum loop families when assemble_opposite_jacobian_in_own_block is set and the preconditioner does not couple the two variables, so that the Jacobian agrees with a finite difference of the residual.'
  []
  [continuum_moments]
    type = CSVDiff
    input = continuum_moments.i
    csvdiff = 'continuum_moments_out.csv'
    design = 'ClusterContinuumMoment.md'
    requirement = 'BlackBear shall compute the number density, the point-defect content and the mean radius of a cluster size distribution that is discrete up to a switch size and a continuum above it, with a minimum cluster size that cuts a continuum cell at the lower edge of that size, so that a constant concentration per unit size gives the exact values.'
  []
  [continuum_loop_observables]
    type = CSVDiff
    input = continuum_loop_observables.i
    csvdiff = 'continuum_loop_observables_out.csv'
    design = 'ClusterContinuumMoment.md'
    requirement = 'BlackBear shall compute the dislocation line length and the lattice-parameter change of a loop family whose size distribution is discrete up to a switch size and a continuum above it, with a minimum cluster size, so that a constant concentration per unit size gives the exact values.'
  []
  [continuum_distribution]
    type = CSVDiff
    input = continuum_distribution.i
    csvdiff = 'continuum_distribution_out_distribution_0001.csv'
    design = 'ClusterContinuumDistribution.md'
    requirement = 'BlackBear shall report the size distribution of a cluster variable that is discrete up to a switch size and a continuum above it, with the size, the width of the size interval, the concentration per unit size and the radius of every discrete size and continuum cell.'
  []
  [continuum_solute_jacobian]
    type = PetscJacobianTester
    input = continuum_solute_jacobian.i
    run_sim = True
    ratio_tol = 1e-7
    difference_tol = 1e6
    design = 'ContinuumClusterDynamicsNodalKernel.md'
    requirement = 'BlackBear shall provide a Jacobian for the solute-clustering kernel whose large sizes are a Fokker-Planck continuum, including the dependence of the minmod-limited face values on the neighboring cells, that agrees with a finite difference of its residual.'
  []
  [continuum_solute_vacancy_jacobian]
    type = PetscJacobianTester
    input = continuum_solute_vacancy_jacobian.i
