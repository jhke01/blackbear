    design = 'ContinuumClusterDynamicsNodalKernel.md'
    requirement = 'BlackBear shall provide the off-diagonal Jacobian column of a coupled vacancy monomer for the continuum solute-clustering kernel, whose monomer diffusivity is scaled by the vacancy supersaturation.'
  []
  [continuum_loop_transient]
    type = CSVDiff
